# ---- Server ----
PORT=3000

# ---- Database ----
# SQLite file for local dev. Swap to a Postgres URL later for production
# without changing any application code (Prisma handles both).
DATABASE_URL="file:./dev.db"

# ---- Data providers ----
# No mock data anywhere in this app: an unconfigured/missing-key source is
# simply skipped (clearly logged), not faked. Fixtures (ESPN), news (RSS),
# and stats (ESPN) all run for real with zero keys. The AI agent needs the
# `claude` CLI installed + logged in (see "AI agent" below), not an API
# key. Nothing in the app is actually gated on a key except the optional
# extras below.
#
# Which sources are active is controlled in code, not here — see
# src/config/dataSources.ts (the DATA_SOURCES registry) for the full list
# and its enabled/disabled flags. Env vars below only hold credentials for
# sources that registry turns on.

# Optional, fallback-only as of 2026-08-03: https://the-odds-api.com.
# resultsIngestion.ts calls this for final-score results ONLY when ESPN
# can't resolve a fixture — it no longer supplies fixtures (those come
# from src/providers/fixtures/EspnFixtureProvider.ts, no key needed) or
# odds/market pricing for the analysis prompt (that's the model's own web
# search now — see analyzeEvent.ts). Leave ODDS_PROVIDER blank to skip
# this fallback entirely; ESPN already covers most results on its own.
ODDS_PROVIDER=                # the-odds-api (only valid value; blank = fallback disabled)
THE_ODDS_API_KEY=
ODDS_REGIONS=uk               # which bookmakers' odds come back, if THE_ODDS_API_KEY is set

# News: https://newsdata.io (free tier available, and unlike newsapi's free
# tier, its terms permit commercial use). Only used if "newsdata-io" is
# enabled in src/config/dataSources.ts (it is, by default) — if this key is
# blank, that source is skipped; the other enabled news sources (BBC/ESPN
# RSS, no key needed) still run.
NEWSDATA_API_KEY=

# Legacy/optional: https://newsapi.org. Disabled by default in
# src/config/dataSources.ts ("newsapi" entry) in favor of newsdata-io — its
# free tier doesn't permit commercial use. Only needed if you re-enable that
# entry.
NEWSAPI_KEY=

# ---- AI agent ----
# ClaudeCodeAgent is the only agent provider as of 2026-08-02 — GeminiAgent,
# ClaudeAgent (direct Anthropic API), OpenAIAgent, and the FallbackAgent
# wrapper that chained them were removed after all three metered/API-key
# paths sat genuinely unusable for a full day (Gemini blocked on a Google
# Cloud billing-link requirement, Claude out of API credits, OpenAI over
# quota) while Claude Code — subscription-billed, no API key needed — was
# verified live and working well. No AGENT_PROVIDER/AGENT_FALLBACK_ORDER
# env vars anymore; there's nothing to select between. Requires the
# `claude` CLI installed and logged in via a Claude Pro/Max subscription
# (npm install -g @anthropic-ai/claude-code, then run `claude` once to
# authenticate) — no mock agent exists, so pick generation fails with a
# clear error if it's missing/unauthenticated rather than returning fake
# output.

# ---- Claude Code subprocess tuning (ClaudeCodeAgent only) ----
# Optional — sensible defaults apply if unset. See ClaudeCodeAgent.ts.
CLAUDE_CODE_TIMEOUT_MS=180000              # per-call subprocess timeout
CLAUDE_CODE_USAGE_LIMIT_COOLDOWN_MS=900000 # how long to skip claude-code after a usage-limit hit (15min default)
CLAUDE_CODE_BIN=                           # absolute path to the claude binary — set this if a bare "claude" isn't on the PATH of whatever process starts this server (see ClaudeCodeAgent.ts); leave blank to just use "claude" from PATH

# ---- Polling ----
# FIXTURE_POLL_INTERVAL_HOURS covers fixture discovery (fixtureScheduler.ts
# — ESPN, no key needed). 24h fits the "today only" fixture ingestion
# window; the cron fires right at UTC midnight to pick up the new day's
# fixtures, plus once immediately on server startup regardless.
FIXTURE_POLL_INTERVAL_HOURS=24
NEWS_POLL_INTERVAL_MINUTES=15
